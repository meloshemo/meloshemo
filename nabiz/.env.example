# Postgres bağlantısı. Boş bırakılırsa uygulama bellek-içi depoyla (seed verisiyle) çalışır.
DATABASE_URL=

# Oturum çerezi imzalama anahtarı (min 32 karakter). Üretimde ZORUNLU.
SESSION_SECRET=

# IP/oturum hash'lerinde kullanılan taban tuz. Günlük döndürme bunun üzerine uygulanır.
# Üretimde ZORUNLU, asla repoya girmez.
VOTE_HASH_SALT=

# Genel site adresi (paylaşım kartları ve canonical URL için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
