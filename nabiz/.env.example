# Postgres bağlantısı. Boş bırakılırsa geliştirmede bellek içi depo kullanılır.
# Üretimde ZORUNLUDUR.
DATABASE_URL=

# Oturum çerezi imzalama anahtarı (min 32 karakter). Üretimde ZORUNLU.
SESSION_SECRET=

# IP/oturum hash'lerinde kullanılan taban tuz (günlük döndürme bunun üzerine uygulanır).
# Üretimde ZORUNLU, asla repoya girmez.
VOTE_HASH_SALT=

# Tanımlıysa /admin paneli açılır (min 24 karakter). Tanımlı değilse admin tamamen kapalıdır.
ADMIN_TOKEN=

# Genel site adresi (canonical URL, sitemap ve paylaşım kartları için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# YALNIZCA test amaçlı: üretim derlemesini veritabanı olmadan çalıştırır. Üretimde kullanma.
# ALLOW_MEMORY_STORE=
