{
  "name": "nabiz",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "npm run dev --workspace @nabiz/web",
    "build": "npm run build --workspace @nabiz/web",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "lint": "next lint --dir apps/web/src"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "@types/node": "^22.9.0"
  }
}
