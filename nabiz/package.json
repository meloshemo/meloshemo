{
  "name": "nabiz",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @nabiz/web",
    "build": "npm run build --workspace @nabiz/web",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "lint": "next lint --dir apps/web/src",
    "test:e2e": "node scripts/e2e.mjs",
    "recount": "npx tsx infra/jobs/recount.ts",
    "seed": "npx tsx infra/jobs/seed.ts",
    "db:generate": "npm run generate --workspace @nabiz/db",
    "db:migrate": "cd packages/db && npx drizzle-kit migrate",
    "preflight": "node scripts/preflight.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2"
  }
}